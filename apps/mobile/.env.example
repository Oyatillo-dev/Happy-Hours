# Base URL of the Sakta API (apps/api).
# On a real phone "localhost" is the phone itself — use your computer's LAN IP,
# e.g. http://192.168.1.10:4000 (and start the API with PUBLIC_URL set to the same address).
# Android emulator: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: EAS project id, needed for real Expo push tokens (dev build / EAS build).
# EXPO_PUBLIC_EAS_PROJECT_ID=
# Optional: Google Maps key for Android builds (Expo Go does not need it).
# GOOGLE_MAPS_ANDROID_API_KEY=
