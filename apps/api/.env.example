NODE_ENV=development
PORT=4000
# Public URL of this API, used for payment redirect pages and uploaded files
PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://hh:hh@localhost:5432/happyhours

# Use long random strings in production
JWT_SECRET=change-me-access
PAYMENT_WEBHOOK_SECRET=change-me-webhook

# Comma separated phones that become ADMIN on first login
ADMIN_PHONES=+996700000001

# console = print OTP codes to the log (dev only)
SMS_PROVIDER=console
# mock = built-in payment page; replace with a bank/ELQR adapter in production
PAYMENT_PROVIDER=mock
# console | expo
PUSH_PROVIDER=console

# Comma separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Set to false to disable background jobs (e.g. in tests)
JOBS_ENABLED=true
